module(
    name = "bazel-template-project",
    version = "1.0",
)

# Bumped for Bazel 8.7 compatibility (rules_go 0.57 hits Facts.clear bug on go_sdk).
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_python", version = "1.6.1")
bazel_dep(name = "rules_uv", version = "0.88.0")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4")

# Go SDK: pin from go.mod.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# External Go deps from go.mod (none yet; bazel mod tidy keeps use_repo in sync).
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

PYTHON_VERSION = "3.13"

python.defaults(python_version = PYTHON_VERSION)
python.toolchain(python_version = PYTHON_VERSION)

# Host interpreter for repository-rule evaluation (uv pip install).
use_repo(python, "python_3_13", "python_3_13_host")

# Runtime Python packages: install with uv (not rules_python pip.parse / @pypi).
# Locking stays on rules_uv pip_compile -> requirements.txt.
uv_pip_repository = use_repo_rule("//tools/python:uv_pip.bzl", "uv_pip_repository")

uv_pip_repository(
    name = "uv_deps",
    python_interpreter = "@python_3_13_host//:python",
    requirements = "//:requirements.txt",
)
