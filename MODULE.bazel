module(name = "bazel-template-project", version = "1.0")

bazel_dep(name = "rules_go", version = "0.57.0") # Add repo_name = "io_bazel_rules_go" if WORKSPACE compatibility is needed
bazel_dep(name = "gazelle", version = "0.45.0")  # Add repo_name = "bazel_gazelle" if WORKSPACE compatibility is needed
bazel_dep(name = "rules_python", version = "1.6.1")
bazel_dep(name = "rules_uv", version = "0.88.0")
bazel_dep(name = "pre-commit", version = "1.0.9")
bazel_dep(name = "pre-commit-hooks", version = "1.3.1")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

PYTHON_VERSION = "3.13"

python.defaults(python_version = PYTHON_VERSION)
python.toolchain(python_version = PYTHON_VERSION)

pip.parse(
    hub_name = "pypi",
    python_version = PYTHON_VERSION,
    requirements_lock = "//:requirements.txt",
)

use_repo(pip, "pypi")
