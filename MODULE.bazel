module(
    name = "bazel-template-project",
    version = "1.0",
)

# Every tool (compilers, formatters, linters, test frameworks, hook runner) is
# declared here; nothing is installed on the host except Bazelisk/Bazel.

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Go.
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")

# Python.
bazel_dep(name = "rules_python", version = "2.3.4")
bazel_dep(name = "rules_uv", version = "0.89.2")

# rules_uv fetches uv through rules_multitool; the root lockfile overrides its
# pinned uv (0.8.12, GHSA-w476-p2h3-79g9 / GHSA-pqhf-p39g-3x64 /
# GHSA-pjjw-68hj-v9mw / GHSA-4gg8-gxpx-9rph) with a patched release.
bazel_dep(name = "rules_multitool", version = "1.11.1")

# Starlark formatting.
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

# C / C++.
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

# Rust.
bazel_dep(name = "rules_rust", version = "0.74.0")

# JavaScript / TypeScript.
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "aspect_rules_js", version = "3.4.1")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")

bazel_dep(name = "aspect_rules_jest", version = "0.26.0", dev_dependency = True)

# Lint aspects (clang-tidy) with lint_test targets.
bazel_dep(name = "aspect_rules_lint", version = "2.9.0", dev_dependency = True)

# ---------------------------------------------------------------------------
# Go SDK: pin from go.mod. nogo runs `go vet` analyzers on every Go compile.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")
go_sdk.nogo(
    includes = ["//:__subpackages__"],
    nogo = "//tools/go:nogo",
)

# External Go deps from go.mod (bazel mod tidy keeps use_repo in sync).
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_stretchr_testify")

# ---------------------------------------------------------------------------
# Python: hermetic interpreter from rules_python.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")

PYTHON_VERSION = "3.13"

python.defaults(python_version = PYTHON_VERSION)
python.toolchain(python_version = PYTHON_VERSION)

# rules_python 2.3.4 maps 3.13 to 3.13.13; use the newer python-build-standalone
# 3.13.15 builds listed (with sha256) in //tools/python:runtimes_manifest.txt.
python.override(
    add_runtime_manifest_files = ["//tools/python:runtimes_manifest.txt"],
    minor_mapping = {PYTHON_VERSION: "3.13.15"},
)

# Host interpreter for repository-rule evaluation (uv pip install).
use_repo(python, "python_3_13", "python_3_13_host")

# Runtime Python packages: install with uv (not rules_python pip.parse / @pypi).
# Locking stays on rules_uv pip_compile -> requirements.txt.
uv_pip_repository = use_repo_rule("//tools/python:uv_pip.bzl", "uv_pip_repository")

uv_pip_repository(
    name = "uv_deps",
    python_interpreter = "@python_3_13_host//:python",
    requirements = "//:requirements.txt",
)

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//tools/python:uv.lock.json")
use_repo(multitool, "multitool")

# ---------------------------------------------------------------------------
# C / C++: hermetic zig cc toolchain (hermetic_cc_toolchain). Zig bundles clang,
# lld, libc headers (glibc/musl/macOS) and libc++, so no host compiler,
# sysroot or Xcode SDK is used. clang-format / clang-tidy come from their
# PyPI wheels via @uv_deps (see requirements.txt and //tools/cpp).
zig_toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.28",
    "@zig_sdk//toolchain:linux_arm64_gnu.2.28",
    "@zig_sdk//toolchain:darwin_amd64",
    "@zig_sdk//toolchain:darwin_arm64",
)

# ---------------------------------------------------------------------------
# Rust: pinned stable toolchain (rustc, rustfmt, clippy). No crates.io deps.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.98.1"],
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# ---------------------------------------------------------------------------
# Node.js: hermetic toolchain via rules_nodejs.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "24.21.0")

# npm packages (TypeScript, ESLint, Prettier, Jest) from pnpm-lock.yaml.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm")

# Matching pnpm for lockfile updates:
#   bazel run -- @pnpm --dir $PWD install --lockfile-only
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
use_repo(pnpm, "pnpm")

# TypeScript compiler version taken from package.json devDependencies.
typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript", dev_dependency = True)
typescript.deps(
    version_from = "//:package.json",
)
use_repo(typescript, "npm_typescript")

# ---------------------------------------------------------------------------
# prek (pre-commit hook runner): pinned release binaries, exposed as //tools:prek.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

PREK_VERSION = "0.5.3"

PREK_BUILD = 'exports_files(["prek"], visibility = ["//visibility:public"])'

http_archive(
    name = "prek_aarch64_apple_darwin",
    build_file_content = PREK_BUILD,
    sha256 = "6006cc4e69cfc86d55f4e407ca60ba960a521befa54fece94038639b1f4de381",
    strip_prefix = "prek-aarch64-apple-darwin",
    urls = ["https://github.com/j178/prek/releases/download/v{}/prek-aarch64-apple-darwin.tar.gz".format(PREK_VERSION)],
)

http_archive(
    name = "prek_aarch64_unknown_linux_musl",
    build_file_content = PREK_BUILD,
    sha256 = "ad3fe48802a02ec82286ab842c4a09a4e1db765e402f1fcc016f75b6929ec480",
    strip_prefix = "prek-aarch64-unknown-linux-musl",
    urls = ["https://github.com/j178/prek/releases/download/v{}/prek-aarch64-unknown-linux-musl.tar.gz".format(PREK_VERSION)],
)

http_archive(
    name = "prek_x86_64_apple_darwin",
    build_file_content = PREK_BUILD,
    sha256 = "874f05d12e7cb672758295b5253dfd05aadad3c2bcaa42ae712b917294629b07",
    strip_prefix = "prek-x86_64-apple-darwin",
    urls = ["https://github.com/j178/prek/releases/download/v{}/prek-x86_64-apple-darwin.tar.gz".format(PREK_VERSION)],
)

http_archive(
    name = "prek_x86_64_unknown_linux_musl",
    build_file_content = PREK_BUILD,
    sha256 = "d4eae1f31c0817d0a9bfa532d4bb66df60a8b01f121def002021915e826c3d1f",
    strip_prefix = "prek-x86_64-unknown-linux-musl",
    urls = ["https://github.com/j178/prek/releases/download/v{}/prek-x86_64-unknown-linux-musl.tar.gz".format(PREK_VERSION)],
)
